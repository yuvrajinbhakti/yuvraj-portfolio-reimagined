# Contact form (EmailJS). Without these the form renders and validates but
# will not send. See EMAILJS_SETUP.md.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# The cursor presence relay (see presence/README.md).
#
# Unset, the cursor layer falls back to BroadcastChannel — the visitor's own
# tabs and nothing else — which is how the site behaved before the relay
# existed. Nothing breaks without it.
#
# Must be a ws:// or wss:// URL. Vite inlines VITE_ variables at build time, so
# changing this on the host requires a rebuild, not just a restart.
VITE_PRESENCE_URL=wss://ysn-presence.<your-subdomain>.workers.dev/presence
